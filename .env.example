# Polaris — переменные окружения. Скопируйте в .env (локально) или задайте в Render.
# Секреты не коммитьте. Пустые значения считаются «не заданы».

# ── Сервер ───────────────────────────────────────────────────────────────────
NODE_ENV=development            # production на Render
PORT=8787                       # Render выставляет сам
PUBLIC_URL=                     # https://polaris-xxxx.onrender.com — для cookie Secure и проверки Origin
INSTANCE_TIMEZONE=UTC           # например Asia/Almaty: расписания, напоминания, сводка, «сегодня» в бюджете
LOG_LEVEL=info

# ── База данных ──────────────────────────────────────────────────────────────
# Supabase Postgres (Session pooler, порт 5432). Без DATABASE_URL (только вне production)
# сервер использует встроенный PGlite в каталоге DATA_DIR — удобно для локальной разработки.
DATABASE_URL=
DATA_DIR=./data
AUTO_MIGRATE=true               # false, если применяете supabase/migrations через Supabase CLI

# ── Доступ ───────────────────────────────────────────────────────────────────
# Пароль инстанса хранится как bcrypt-хэш:  npm run hash-password -- "пароль"
POLARIS_PASSWORD_HASH=
# Только для локальной разработки (в production игнорируется): пароль открытым текстом
POLARIS_PASSWORD=
# 32 байта в base64 или 64 hex: openssl rand -base64 32 — шифрует OAuth-токены ChatGPT
ENCRYPTION_KEY=
SESSION_TTL_DAYS=30
# Секрет для POST /internal/tick (pg_cron); см. supabase/optional/pg_cron_jobs.sql
CRON_SECRET=

# ── Провайдеры моделей (порядок фолбэка; ChatGPT OAuth всегда последний) ─────
PROVIDER_ORDER=openrouter,gemini,ollama
PROVIDER_TIMEOUT_MS=60000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # для демо-модели: http://127.0.0.1:8799/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=                # http://localhost:11434
OLLAMA_MODEL=
# ChatGPT по OAuth включается в приложении (Ещё → Настройки). Значения по умолчанию взяты из openai/codex:
CHATGPT_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
CHATGPT_REDIRECT_URI=http://localhost:1455/auth/callback
CHATGPT_MODEL=gpt-6-luna
CHATGPT_MODELS=gpt-6-luna,gpt-5.1-codex,gpt-5-codex,gpt-5
# Цены для расчёта $ по моделям без собственного отчёта о стоимости: {"model":{"in":0.3,"out":2.5}} ($ за 1 млн токенов)
PRICES_JSON=

# ── Инструменты ──────────────────────────────────────────────────────────────
BRAVE_API_KEY=                  # веб-поиск (Brave Search API)
# Файлы: Supabase Storage (иначе локальный каталог LOCAL_FILES_DIR или DATA_DIR/files)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=polaris-files
LOCAL_FILES_DIR=
# Браузер Playwright: локальный Chromium или внешний сервис по CDP (рекомендуется для Render free, 512 МБ)
BROWSER_ENABLED=false
BROWSER_EXECUTABLE_PATH=
BROWSER_WS_ENDPOINT=            # wss://… (Browserless и аналоги)
BROWSER_MAX_MEMORY_MB=300
# Разрешить чтение локальной сети инструментами read_url/браузер (по умолчанию запрещено — защита от SSRF)
ALLOW_PRIVATE_NETWORK=false

# ── Бюджет (меняется и в приложении). 0 — без лимита ─────────────────────────
BUDGET_DAILY_TOKENS=500000
BUDGET_DAILY_USD=2
BUDGET_RUN_TOKENS=100000
BUDGET_RUN_USD=0.5

# ── Планировщик и агент ──────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
MAX_CONCURRENT_RUNS=2
APPROVAL_TTL_HOURS=48
AGENT_MAX_STEPS=12
AGENT_CONTEXT_TOKENS=24000
TOOL_TIMEOUT_MS=30000
