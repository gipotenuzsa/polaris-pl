{
  "name": "@polaris/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:env": "node --env-file-if-exists=../.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "vitest run --no-file-parallelism",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "playwright-core": "^1.64.1"
  }
}
